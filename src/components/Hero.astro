---
import products from '../data/products.json';
import {coverPhotoFor} from '../lib/product-photos.js';
const featured = [
  {key:'ninja',tone:'pixel',line:'De aquí a otros mundos.'},
  {key:'marco-de-angeles',tone:'gothic',line:'Arte que llevas contigo.'},
  {key:'japones',tone:'red',line:'Ilustración con carácter.'},
].map(scene=>({...scene,product:products.find(product=>product.key===scene.key)}));
---
<section class="featured" id="inicio" aria-labelledby="featured-title">
  <div class="featured-intro">
    <div><p class="eyebrow">DOS MIRADAS · UNA COLECCIÓN</p><h1 id="featured-title">Diseños que cuentan algo.</h1></div>
    <p>Playeras oversize de algodón. Encuentra la que va contigo.</p>
  </div>
  <div class="featured-carousel" data-showcase role="region" aria-roledescription="carrusel" aria-label="Diseños destacados" tabindex="0">
    <div class="featured-stage" aria-live="off">
      {featured.map(({product:p,tone,line},i)=>{
        const photo=coverPhotoFor(p);
        return <article class="featured-slide" data-featured-slide data-key={p.key} data-owner={p.author==='Nai'?'nai':'seb'} data-tone={tone} hidden={i!==0} role="group" aria-roledescription="diapositiva" aria-label={`${i+1} de ${featured.length}: ${p.name}`}>
          <div class="featured-atmosphere" aria-hidden="true"><i></i><i></i><i></i></div>
          <div class="featured-copy"><p class="featured-brand">{p.brand} <span>POR {p.author.toUpperCase()}</span></p><h2>{p.name}</h2><p class="featured-line">{line}</p><a class="button featured-cta" href={`ficha-${p.key}.html`}>Ver playera <span aria-hidden="true">↗</span></a></div>
          <a class="featured-photo" href={`ficha-${p.key}.html`} aria-label={`Ver playera ${p.name}`}><img src={photo.displaySrc} alt={`${p.name} · ${photo.alt}`} width={photo.width} height={photo.height} decoding="async" loading="eager" fetchpriority={i===0?'high':'auto'}/></a>
          <span class="featured-note" aria-hidden="true">{tone==='pixel'?'PIXEL ART':tone==='gothic'?'ARTE GÓTICO':'TRAZOS ROJOS'} / OVERSIZE</span>
        </article>;
      })}
    </div>
    <div class="featured-controls" hidden>
      <div class="featured-pagination"><span class="featured-count" aria-hidden="true">01 / 03</span><div class="featured-dots" role="group" aria-label="Elegir diseño destacado">{featured.map(({product:p},i)=><button type="button" data-featured-index={i} aria-label={`Mostrar ${p.name}`} aria-pressed={String(i===0)}><span></span></button>)}</div></div>
      <div class="featured-navigation"><button type="button" data-featured-prev aria-label="Diseño anterior">←</button><button type="button" data-featured-toggle aria-label="Pausar presentación">Pausar <span aria-hidden="true">Ⅱ</span></button><button type="button" data-featured-next aria-label="Diseño siguiente">→</button></div>
    </div>
  </div>
</section>
