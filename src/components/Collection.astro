---
import products from "../data/products.json";
---
<section class="collection section" id="coleccion">
  <div class="section-heading" id="elige"><div><p class="eyebrow">ENCUENTRA TU DISEÑO</p><h2>Elige tu diseño.</h2></div><p>Toca una playera para ver sus fotos, tallas y detalles.</p></div>
  <div class="gallery-toolbar">
    <div aria-label="Filtrar galería por diseñador" class="designer-filters" role="group"><button aria-pressed="true" data-designer="all" type="button">Ver todos</button><button aria-pressed="false" data-designer="seb" type="button">NOCTBIT <span>{products.filter(p=>p.author==='Seb').length}</span></button><button aria-pressed="false" data-designer="nai" type="button">Malacate <span>{products.filter(p=>p.author==='Nai').length}</span></button></div>
    <div class="gallery-tools"><p id="designer-status" role="status">{products.length} diseños · NOCTBIT + Malacate</p><button aria-label="Silenciar sonido de las colecciones" aria-pressed="true" class="collection-sound" id="collection-sound" type="button">♪ Sonido activado</button></div>
  </div>
  <div class="product-grid" id="designer-gallery">
    {products.map(p => <article class="product" data-owner={p.author==='Nai'?'nai':'seb'}>
      <p class="designer-credit">{p.brand} · Por {p.author}</p>
      <a aria-label={'Ver playera '+p.name} class={'product-image '+p.key} href={'ficha-'+p.key+'.html'}>
        <img alt={p.name+' · '+p.photos[0].alt} loading="lazy" decoding="async" src={p.photos[0].displaySrc}/>
        <span class="image-label">{p.photos[0].imageType ? p.photos[0].imageType+" · " : ""}{p.photos[0].alt}</span><span aria-hidden="true" class="zoom">↗</span>
      </a>
      <div class="product-top"><h3>{p.name}</h3><span>{Object.keys(p.prices).length?'Desde $'+Math.min(...Object.values(p.prices))+' MXN':'Consultar precio'}</span></div>
      {p.key==='muertos'&&<span class="season-tag">De temporada · Día de Muertos</span>}
      <a class="product-sheet-link" href={'ficha-'+p.key+'.html'}>Ver playera <span aria-hidden="true">↗</span></a>
    </article>)}
  </div>
</section>
