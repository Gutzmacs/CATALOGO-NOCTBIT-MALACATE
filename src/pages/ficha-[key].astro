---
import Page from '../layouts/Page.astro';
import PurchaseTerms from '../components/PurchaseTerms.astro';
import InfoTabs from '../components/InfoTabs.astro';
import products from '../data/products.json';
import {finishFor} from '../lib/product-finish.js';
import {coverPhotoFor} from '../lib/product-photos.js';
export function getStaticPaths(){return products.map(product=>({params:{key:product.key},props:{product}}));}
const {product:p}=Astro.props;
const cover=coverPhotoFor(p);
const sizes=['CH','M','G','XL','2XL','3XL'];
const message=`Hola, me interesa ${p.name}, de ${p.brand}. ¿Me ayudas a elegir talla y confirmar precio, disponibilidad y entrega?`;
---
<Page title={`${p.name} · ${p.brand}`} description={p.description} product={p.key} styles={['styles.css','product-detail.css?v=primary-order-1','vendor/photoswipe/photoswipe.css']} scripts={['product-detail.js?v=short-captions-1']}>
<script slot="head" is:inline type="module" src="product-lightbox.js?v=short-captions-1"></script>
<header class="detail-header"><a href="index.html#coleccion">← Volver al catálogo</a><span>{p.brand}<small>POR {p.author.toUpperCase()}</small></span></header>
<main class="product-detail"><section class="detail-photos" aria-label={`Fotos de ${p.name}`}>
<a class="main-photo-link" href={cover.src} target="_blank" rel="noopener" aria-label="Ampliar fotos del diseño"><img id="detail-photo" src={cover.displaySrc} alt={`${cover.alt} de ${p.name}`} width={cover.width} height={cover.height} decoding="async" fetchpriority="high"/></a>
<p id="photo-caption">Toca para ampliar</p>
<div class="photo-thumbs">{p.photos.map(photo=><button class="photo-thumb" type="button" data-photo={photo.displaySrc} data-caption={photo.alt} data-original={photo.src} data-width={photo.width} data-height={photo.height} aria-label={`Ver ${photo.alt}`} aria-pressed={String(photo===cover)}><img src={photo.displaySrc.replace(".webp", "-thumb.webp")} alt={photo.alt} loading="lazy" decoding="async"/><span>{photo.label || photo.alt}</span></button>)}</div>
</section><section class="detail-info"><p class="eyebrow">{p.brand} · POR {p.author.toUpperCase()}</p>{p.key==='muertos'&&<span class="season-tag">TEMPORADA · DÍA DE MUERTOS</span>}<h1>{p.name}</h1><p class="detail-description">{p.description}</p>
<div class="fit-summary"><span class="eyebrow">CORTE Y AJUSTE</span><p>Algodón · Corte oversize · Hombros caídos</p><button type="button" class="size-guide-button" data-open-size-guide>Ver cómo medirme ↗</button></div>
<div class="product-share"><button type="button" id="share-product">Compartir playera ↗</button><a id="share-whatsapp" target="_blank" rel="noopener" hidden>Compartir por WhatsApp ↗</a><p id="share-status" role="status"></p><input id="share-url" aria-label="Enlace de esta playera para copiar" readonly hidden/></div>
<form id="detail-form">
 <fieldset aria-describedby="detail-size-note"><legend>Elige tu talla</legend><div class="detail-sizes">{sizes.map(size=><label><input type="radio" name="size" value={size} required/><span>{size}{size==='3XL'&&<small>Consultar</small>}</span></label>)}</div></fieldset>
 <button type="button" class="size-guide-button size-link-inline" data-open-size-guide>Cómo elegir mi talla ↗</button>
 <p class="stock-note" id="detail-size-note" role="status">Selecciona tu talla para ver el precio exacto y agregarla a tu pedido.</p>
 <p class="size-consult-note" id="detail-3xl-note" hidden>3XL: confirma sus medidas y disponibilidad por WhatsApp antes de cerrar tu pedido.</p>
 <div class="detail-price"><span>Precio por playera</span><output id="detail-price" aria-live="polite">Elige tu talla</output></div>
 <p class="detail-extra">{finishFor(p)}</p>
 <div class="quantity-guide"><label class="quantity-field" for="detail-quantity">CANTIDAD<input id="detail-quantity" name="quantity" type="number" min="1" max="20" step="1" value="1" required/></label></div>
 <button class="button dark add-order-button" type="button" data-add-order data-order-form="#detail-form" data-product-key={p.key} disabled>Elige tu talla para agregar</button>
 <a class="order-secondary-link" id="order-whatsapp" role="link" aria-disabled="true" tabindex="-1">Consultar por WhatsApp ↗</a>
 <p class="detail-help order-message-help">Revisa y envía tu selección por WhatsApp para confirmar el pedido.</p>
 <PurchaseTerms />
 <noscript><p class="detail-help">Para armar tu pedido, activa JavaScript o <a href={'https://wa.me/525636457353?text='+encodeURIComponent(message)}>consúltanos por WhatsApp</a>.</p></noscript>
</form>
<InfoTabs id="prenda" tabs={[{key:'detalle',label:'La prenda'},{key:'acabado',label:'Acabado'},{key:'cuidados',label:'Cuidados'}]}>
 <p slot="detalle">Algodón y corte oversize.</p>
 <p slot="acabado">{finishFor(p)}{p.key !== 'marco-de-angeles' && ' El semitono deja espacios sin tinta; la transpirabilidad depende de la cobertura del diseño.'}</p>
 <p slot="cuidados">Lava al revés con agua fría. Seca a la sombra y evita cloro, secadora y planchado directo sobre el diseño.</p>
</InfoTabs>
</section></main><footer><a href="index.html#coleccion">← Seguir explorando</a><p>NOCTBIT · Malacate</p></footer>
<script is:inline type="application/json" id="detail-data" set:html={JSON.stringify({key:p.key,name:p.name,brand:p.brand,finish:finishFor(p),prices:p.prices})}></script>
<script is:inline type="application/json" id="photo-data" set:html={JSON.stringify(p.photos)}></script>
</Page>
