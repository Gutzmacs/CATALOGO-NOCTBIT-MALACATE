---
import ShoppingTools from "../components/ShoppingTools.astro";
const {title, description, styles = [], scripts = [], product} = Astro.props;
---
<!doctype html><html lang="es-MX"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#0b0b18"/><meta name="description" content={description}/><title>{title}</title>{styles.map(href => <link rel="stylesheet" href={href}/>)}{scripts.map(src => <script is:inline src={src} defer></script>)}<link rel="stylesheet" href="shopping.css?v=choose-size-1"/><link rel="stylesheet" href="purchase.css?v=1"/><link rel="stylesheet" href="price-layout.css?v=mobile-2"/><slot name="head"/></head><body data-product={product}><slot/><ShoppingTools /></body></html>
